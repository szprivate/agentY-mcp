# (agenty_core.paths.corpus_root); they must NOT be re-created here, or the
# repos would drift apart again. The tool layer reads them from agenty_core.
comfyui_workflow_templates_custom/
comfyui_workflow_templates_official/
config/workflow_templates.json
config/workflow_recipes.json
config/workflow_recipes_node_knowledge.json
config/workflow_recipes_report.md
config/workflow_recipes_object_info_cache.json

# downloaded helper programs (Brush, the splat trainer)
/tools/

config/settings.local.json
config/.mcp_tokens/
config/mcp_bundles/
.agenty_token*
/output/

# ── Secrets audit 2026-10-29: things that must never be addable ─────────────
# Key/credential files of any name, and private keys.
keys*.txt
*.pem
*.p12
*.pfx
id_rsa*
# Conversation / memory databases and archives of them: full chat history,
# tool results (which have held .env contents) and prompts.
memory.zip
*.sqlite
*.sqlite3
*.db
# Logs (message history, token logs, MCP server logs) and tool caches.
/logs/
.logs/
.playwright-mcp/
.cache/
.remotion/
